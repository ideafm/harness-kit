#!/bin/bash
prompt="" model=""
[ -n "$FAKE_LOG" ] && printf '%s\n' "$@" >"$FAKE_LOG.args"
while [ $# -gt 0 ]; do
  case "$1" in
    -p) prompt=$2; shift ;;
    --model) model=$2; shift ;;
  esac
  shift
done
plan=$(grep -oE 'docs/plans/[^ ]+\.md' <<<"$prompt" | head -1 | sed 's/\.$//')
id=$(grep -oE 'B-[0-9]+' <<<"$prompt" | head -1)
state="$CLAUDE_PROJECT_DIR/.claude/tw-state"
mkdir -p "$state"
mode=${FAKE_MODE:-ok}
[ "$mode" = sonnet-red ] && { [ "$model" = sonnet ] && mode=red || mode=ok; }
if [ "$mode" = limit-once ]; then
  [ -f "$FAKE_LOG.limited" ] && mode=ok || { touch "$FAKE_LOG.limited"; mode=limit; }
fi
echo "{\"type\":\"system\",\"subtype\":\"init\",\"model\":\"$model\",\"session_id\":\"fake-$$\",\"cwd\":\"$PWD\"}"
echo "$model" >>"$FAKE_LOG"

finish() { echo "{\"type\":\"result\",\"num_turns\":3,\"total_cost_usd\":0.01,\"duration_ms\":1000}"; exit 0; }
close_plan() { perl -0pi -e 's/- \[ \] (\d+\.)/- [x] $1/g' "$plan"; }

[ -n "$FAKE_LOG" ] && echo "$id slot=$TW_SLOT db=$TEST_DB" >>"$FAKE_LOG.env"
case "$mode" in
  slow)
    sleep "${FAKE_SLEEP:-2}"
    echo "work $model $id" >>"src/$id.txt"
    close_plan
    echo "green now" >"$state/last-test"
    echo "ok now" >"$state/last-verify"
    finish ;;
  ok)
    echo "work $model $id" >>src/app.txt
    close_plan
    echo "green now" >"$state/last-test"
    echo "ok now" >"$state/last-verify"
    finish ;;
  breaks)
    echo "BREAK $id" >>src/other.txt
    close_plan
    echo "green now" >"$state/last-test"
    echo "ok now" >"$state/last-verify"
    finish ;;
  red)
    echo "broken" >>src/app.txt
    echo "red now" >"$state/last-test"
    finish ;;
  human)
    echo "half" >>src/app.txt
    printf -- '- today · нужен человек: выбрать формат\n' >>"$plan"
    echo "green now" >"$state/last-test"
    finish ;;
  denied)
    echo "half" >>src/app.txt
    printf -- '- today · нужен человек: запустить тест\n' >>"$plan"
    echo "green now" >"$state/last-test"
    echo '{"type":"result","num_turns":3,"total_cost_usd":0.01,"duration_ms":1000,"permission_denials":[{"tool_name":"Bash","tool_input":{"command":"(pnpm a | tail)"}},{"tool_name":"Bash","tool_input":{"command":"bash deploy/t.sh"}},{"tool_name":"Bash","tool_input":{"command":"bash deploy/t.sh"}}]}'
    exit 0 ;;
  noverify)
    echo "work" >>src/app.txt
    close_plan
    echo "green now" >"$state/last-test"
    finish ;;
  hang)
    echo "partial" >>src/app.txt
    sleep 60 &
    wait
    finish ;;
  limit)
    echo "{\"type\":\"result\",\"is_error\":true,\"result\":\"usage limit reached\"}"
    exit 1 ;;
esac
